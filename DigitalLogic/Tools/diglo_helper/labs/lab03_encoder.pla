# Lab03-03  Binary Encoder   (Template-03.dig: In[4] Selector[2] -> Output[4])
# Input  (6 bit): S1 S0 = Selector, In3..In0 = In (BCD 0-9)
# Output (4 bit): O3..O0
# Selector: 00=Excess-3   01=Cyclic   10=2421   11=6-4-2--3
.i 6
.o 4
#map Selector=S1,S0
#map Output=O3,O2,O1,O0
.ilb S1 S0 In3 In2 In1 In0
.ob O3 O2 O1 O0
.type fd

# --- Sel=00 : Excess-3 (= In + 3) ---
000000 0011
000001 0100
000010 0101
000011 0110
000100 0111
000101 1000
000110 1001
000111 1010
001000 1011
001001 1100

# --- Sel=01 : Cyclic (Gray) ---
010000 0000
010001 0001
010010 0011
010011 0010
010100 0110
010101 0111
010110 0101
010111 0100
011000 1100
011001 1101

# --- Sel=10 : 2 4 2 1 ---
100000 0000
100001 0001
100010 0010
100011 0011
100100 0100
100101 1011
100110 1100
100111 1101
101000 1110
101001 1111

# --- Sel=11 : 6 4 2 -3 ---
110000 0000
110001 0101
110010 0010
110011 1001
110100 0100
110101 1011
110110 0110
110111 1101
111000 1010
111001 1111

# --- don't care : In = 10..15 never occur (A is 0-9), any selector ---
--11-- ----
--1-1- ----
.e
